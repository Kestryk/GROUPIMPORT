<div class="easyedu-guide" data-easyedu-guide-root>
    <button type="button" class="btn easyedu-guide__launcher" data-easyedu-guide-open="1">
        <span class="easyedu-guide__launcher-icon" aria-hidden="true">
            <span class="fa fa-compass" aria-hidden="true"></span>
        </span>
        <span class="easyedu-guide__launcher-label">{{guideopenlabel}}</span>
    </button>

    <div class="easyedu-guide-modal" data-easyedu-guide-modal hidden role="dialog" aria-modal="true" aria-labelledby="easyedu-guide-title">
        <div class="easyedu-guide-modal__dialog">
            <header class="easyedu-guide-modal__header">
                <div>
                    <span class="easyedu-guide-modal__eyebrow">{{guideeyebrow}}</span>
                    <h2 id="easyedu-guide-title">{{guidetitle}}</h2>
                </div>
                <button type="button" class="btn easyedu-guide-modal__close" data-easyedu-guide-close="1" aria-label="{{guidecloselabel}}">
                    <span class="fa fa-times" aria-hidden="true"></span>
                </button>
            </header>

            <div class="easyedu-guide-nav-wrap">
                <button type="button" class="easyedu-guide-nav-arrow easyedu-guide-nav-arrow--prev" data-easyedu-guide-nav-previous="1" aria-label="{{guidepreviouslabel}}">
                    <span class="fa fa-chevron-left" aria-hidden="true"></span>
                </button>
                <nav class="easyedu-guide-modal__nav easyedu-guide-nav" data-easyedu-guide-nav aria-label="{{guidenavigationlabel}}">
                    {{#slides}}
                        <button type="button" class="easyedu-guide-nav-item{{#hasguidedpath}} has-guided-path{{/hasguidedpath}}" data-easyedu-guide-nav-item="{{index}}">
                            {{#hasguidedpath}}<span class="fa fa-route" aria-hidden="true"></span>{{/hasguidedpath}}
                            {{^hasguidedpath}}<span class="fa fa-circle-info" aria-hidden="true"></span>{{/hasguidedpath}}
                            <span class="easyedu-guide-nav-copy">
                                {{#hasguidedpath}}<small>{{guideguidedpathlabel}}</small>{{/hasguidedpath}}
                                <span>{{title}}</span>
                            </span>
                        </button>
                    {{/slides}}
                </nav>
                <button type="button" class="easyedu-guide-nav-arrow easyedu-guide-nav-arrow--next" data-easyedu-guide-nav-next="1" aria-label="{{guidenextlabel}}">
                    <span class="fa fa-chevron-right" aria-hidden="true"></span>
                </button>
            </div>

            <div class="easyedu-guide-modal__body">
                {{#slides}}
                    <section class="easyedu-guide-slide" data-easyedu-guide-slide="{{index}}" hidden>
                        <div class="easyedu-guide-slide__header">
                            <h3>{{title}}</h3>
                            {{#target}}
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-easyedu-guide-show-target="{{target}}">
                                    {{guideshowinterfacelabel}}
                                </button>
                            {{/target}}
                        </div>
                        <div class="easyedu-guide-slide__content">
                            {{{content}}}
                        </div>
                        {{#guidedpath}}
                            <button type="button" class="btn btn-primary easyedu-guide-slide__start" data-easyedu-guide-start-path="{{guidedpath}}">
                                <span class="fa fa-play" aria-hidden="true"></span>
                                <span>{{guidestartpathlabel}}</span>
                            </button>
                        {{/guidedpath}}
                    </section>
                {{/slides}}
            </div>

            <footer class="easyedu-guide-modal__footer">
                <button type="button" class="btn btn-outline-secondary" data-easyedu-guide-previous="1">{{guidepreviouslabel}}</button>
                <button type="button" class="btn btn-primary" data-easyedu-guide-next="1">{{guidenextlabel}}</button>
            </footer>
        </div>
    </div>

    <aside class="easyedu-guide-checklist easyedu-guided-panel" data-easyedu-guide-checklist hidden>
        <div class="easyedu-guide-checklist__header easyedu-guided-panel__header">
            <div>
                <strong>{{guidechecklisttitle}}</strong>
                <span>{{guideguidedpathlabel}}</span>
            </div>
            <div class="easyedu-guided-panel__header-actions">
                <button type="button" class="btn btn-link easyedu-guided-panel__minimize" data-easyedu-guide-checklist-minimize="1" aria-label="{{guideminimizelabel}}">
                    <span class="fa fa-minus" aria-hidden="true"></span>
                </button>
                <button type="button" class="btn btn-link easyedu-guided-panel__close" data-easyedu-guide-checklist-close="1" aria-label="{{guidecloselabel}}">
                    <span class="fa fa-times" aria-hidden="true"></span>
                </button>
            </div>
        </div>
        <div class="easyedu-guide-checklist__items easyedu-guided-panel__steps" data-easyedu-guide-checklist-items></div>
        <div class="easyedu-guide-checklist__complete easyedu-guided-panel__message" data-easyedu-guide-checklist-message>
            <span class="fa fa-check-circle" aria-hidden="true"></span>
            <span>{{guidechecklistdonelabel}}</span>
        </div>
        <div class="easyedu-guided-panel__footer">
            <button type="button" class="btn btn-outline-primary btn-sm" data-easyedu-guide-checklist-return="1">{{guidereturnlabel}}</button>
        </div>
    </aside>
</div>
